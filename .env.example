# KubeSage Environment Variables
# Copy this file to .env and fill in local values.
# NEVER commit .env to version control.

# Authentication
KUBESAGE_AUTH_TOKEN=your-secret-token-here

# MySQL is configured directly in configs/config.yaml.
# If KubeSage runs inside Docker, use host.docker.internal as mysql.host.

# Redis container
REDIS_PASSWORD=kubesage
REDIS_PORT=6379

# Kubernetes observability endpoints consumed by KubeSage when it runs in Docker.
# Start these with kubectl port-forward; see docs/K8S_OBSERVABILITY.md.
KUBESAGE_PROMETHEUS_BASE_URL=http://host.docker.internal:9091
KUBESAGE_LOKI_BASE_URL=http://host.docker.internal:3102

# Optional local-observability Docker profile ports.
# These are not the Kubernetes RCA data source by default.
PROMETHEUS_PORT=19090
LOKI_PORT=13100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Postgres + pgvector container for Runbook RAG vectors
PGVECTOR_USER=kubesage
PGVECTOR_PASSWORD=kubesage
PGVECTOR_DATABASE=kubesage_vector
PGVECTOR_PORT=5432
PGVECTOR_TABLE=runbook_vectors

# Embedding Provider (OpenAI-compatible)
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# LLM Provider
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-llm-api-key
